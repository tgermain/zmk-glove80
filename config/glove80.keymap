/*
Layers

Those numbers are meaningless.
The actual index of the layers is the one in keymap which are zero indexed.
*/
#define BASE    0
#define ERGOL   1
#define SYMBOL  2
#define ACCENT  3
#define GAME    4
#define MAGIC   5

/ {
    /* Glove80 system behavior & macros */
    behaviors {
        // For the "layer" key, it'd nice to be able to use it as either a shift or a toggle.
        // Configure it as a tap dance, so the first tap (or hold) is a &mo and the second tap is a &to
        lower: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_TAP_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo SYMBOL>, <&to SYMBOL>;
        };

        s_d_cl: shift_double_capslock {
            compatible = "zmk,behavior-tap-dance";
            label = "shift_double_capslock";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHIFT>, <&kp CAPSLOCK>;
        };

        bsp_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    #define BT_MACRO(name)                  \
    bt_ ## name: bt_profile_macro_ ## name {\
        label = "BT_ ## name";              \
        compatible = "zmk,behavior-macro";  \
        #binding-cells = <0>;               \
        bindings                            \
            = <&out OUT_BLE>                \
            , <&bt BT_SEL name>;            \
    };

    macros {
        BT_MACRO(0)
        BT_MACRO(1)
        BT_MACRO(2)
        BT_MACRO(3)

        rgb_ug_status_macro: rgb_ug_status_macro_0 {
            label = "RGB_UG_STATUS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&rgb_ug RGB_STATUS>;
        };

        meh: meh_modifier {
            label = "MEH_MODIFIER";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LS(LC(LALT))>
                , <&macro_pause_for_release>
                , <&macro_release &kp LS(LC(LALT))>
                ;
        };


    #define MACRO(name, keys)             \
    name: name##_macro {                  \
        label = #name;                    \
        compatible = "zmk,behavior-macro";\
        #binding-cells = <0>;             \
        tap-ms = <1>;                     \
        wait-ms = <1>;                    \
        bindings = <keys>;                \
    };

    // french accentuated letters
    #define diaeresis(name, key)    \
    MACRO(fr_ ## name ## _diaeresis, &kp FR_DIAE &kp key)

    #define circumflex(name, key)    \
    MACRO(fr_ ## name ## _circumflex, &kp FR_CIRC &kp key)

        circumflex(a, Q)
        circumflex(e, E)
        circumflex(i, I)
        circumflex(o, O)
        circumflex(u, U)
        diaeresis(a, Q)
        diaeresis(e, E)
        diaeresis(i, I)
        diaeresis(o, O)
        diaeresis(u, U)
    };

